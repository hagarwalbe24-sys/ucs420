def Add(a,b):
    return a+b
print ("Sum of 10 and 20 is: ", Add(10,20))
def prime(n):
    if n <= 1:
        return False
    for i in range(2, int(n**0.5) + 1):
        if n % i == 0:
            return False
    return True

print ("Is 7 prime? ", prime(7))
def add(j):
     return sum(range(1,j+1))
print ("Sum of first 10 numbers is: ", add(10))


